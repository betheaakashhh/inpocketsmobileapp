# Where the app finds the backend. Only EXPO_PUBLIC_* variables reach the app bundle (never put secrets here).
#
# Local development (Expo Go / dev client on a phone on the same Wi-Fi as your computer):
#   use your computer's LAN IP and the backend port, e.g.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8000
#
# Release builds (EAS preview / production) MUST use https and are configured in eas.json:
# the app refuses to start with a non-https URL (or no URL) outside development.
EXPO_PUBLIC_VERBOSE_LOGS=false
