{
  "expo": {
    "name": "InPockets",
    "slug": "inpockets",
    "version": "0.1.1",
    "orientation": "portrait",
    "scheme": "inpockets",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.inpockets.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.inpockets.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "InPockets uses your camera to verify your identity.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "InPockets uses your camera to verify your identity.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0F9FF",
          "dark": {
            "backgroundColor": "#111827"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4181659f-ec25-45a0-bb5c-db86401d5209"
      }
    },
    "owner": "betheaakashhh"
  }
}
